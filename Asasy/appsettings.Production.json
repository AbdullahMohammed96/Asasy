{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PerformanceSettings": {
    "CacheSettings": {
      "DefaultSlidingExpiration": "00:30:00",
      "DefaultAbsoluteExpiration": "01:00:00",
      "MemoryCacheOptions": {
        "SizeLimit": 1024,
        "CompactionPercentage": 0.25
      }
    },
    "CompressionSettings": {
      "EnableForHttps": true,
      "CompressionLevel": "Optimal"
    },
    "StaticFileSettings": {
      "CacheDuration": 31536000,
      "EnableETag": true,
      "EnableLastModified": true
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=aspnet-Asasy;Trusted_Connection=true;MultipleActiveResultSets=true"
  }
}